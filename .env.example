# Example settings only; no real secrets here. Nothing loads this file automatically:
# set these as environment variables before starting the middleware, e.g. (PowerShell)
#   $env:EKYC_MAX_AGE_HOURS = "72"
#   python -m middleware.app

# Offline e-KYC XML verification (all optional; defaults shown)
EKYC_MAX_AGE_HOURS=72
EKYC_DEFAULT_TIMEZONE=+05:30
EKYC_CLOCK_SKEW_SECONDS=300
EKYC_ALLOWED_SIGNATURE_METHODS=RSA_SHA256
EKYC_ALLOWED_DIGESTS=SHA256

# Real UIDAI Offline e-KYC files carry an RSA-SHA1 signature over a SHA-256 digest.
# Off by default. When true, allows exactly that combination (never a SHA-1 digest) and
# still verifies against the pinned certificates only.
EKYC_ALLOW_SHA1_SIGNATURE_WITH_SHA256_DIGEST=false

# Registration accepts only the Offline e-KYC ZIP. Set true to restore the PDF
# (Secure QR / OCR) path, which is kept in the repo but unreachable by default.
REGISTRATION_ALLOW_PDF=false
